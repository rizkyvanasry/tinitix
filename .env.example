# PostgreSQL pooled connection URL (Neon / Supabase / other managed PostgreSQL)
DATABASE_URL=
# Public URL of this deployment. Use the preview URL for a Vercel preview.
APP_URL=http://127.0.0.1:3000
# Generate a random value with at least 32 characters; keep stable for ticket validity.
APP_SECRET=
# Only simulation is implemented. Ignored/blocked in production.
PAYMENT_PROVIDER=simulation
# Optional email transport. Verify sender domain before enabling.
RESEND_API_KEY=
EMAIL_FROM=
# Poster storage on Vercel Blob.
BLOB_READ_WRITE_TOKEN=
# Protect maintenance endpoint; use at least 32 random characters.
CRON_SECRET=
SUPPORT_EMAIL=
# Bootstrap only: set temporarily when running admin:create, then remove.
ADMIN_PASSWORD=

# Delay between completed maintenance batches (milliseconds).
WORKER_INTERVAL_MS=30000
